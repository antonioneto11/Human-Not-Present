# --- Claude ---
# Or use `ant auth login` and leave this unset.
ANTHROPIC_API_KEY=

# --- Network: base-sepolia (testnet, free) | base (mainnet, real USDC) ---
NETWORK=base-sepolia

# --- Agent wallet (npm run wallet:new) ---
AGENT_PRIVATE_KEY=

# --- Merchant ---
MERCHANT_PORT=4021
MERCHANT_PAY_TO=          # any address you control (a second wallet:new)
FACILITATOR_URL=https://x402.org/facilitator   # testnet facilitator; mainnet needs a mainnet facilitator (e.g. Coinbase CDP)

# --- Spend policy (USD) ---
POLICY_MAX_PER_TX_USD=1.00
POLICY_DAILY_BUDGET_USD=2.00
POLICY_APPROVAL_THRESHOLD_USD=0.10
POLICY_ALLOWED_MERCHANTS=localhost:4021

# prompt (ask in terminal) | never (always decline) | always (auto-approve; demos only)
APPROVAL_MODE=prompt
