# --- Claude (required) ---
ANTHROPIC_API_KEY=

# --- Settlement: simulated (default, no real money) | testnet (see NEXT.md) ---
SETTLEMENT=simulated

# --- Testnet only ---
NETWORK=base-sepolia
AGENT_PRIVATE_KEY=                               # npm run wallet:new
FACILITATOR_URL=https://x402.org/facilitator

# --- Spend policy for `npm run agent` (USD). The experiment uses fixed values in src/experiment/run.ts ---
POLICY_MAX_PER_TX_USD=1.00
POLICY_DAILY_BUDGET_USD=2.00
POLICY_APPROVAL_THRESHOLD_USD=0.10
# host[:port] or host[:port]=0xPayee (payee pinning), comma-separated
POLICY_ALLOWED_MERCHANTS=localhost:4021

# prompt (ask in terminal) | never (always decline) | always (auto-approve; demos only)
APPROVAL_MODE=prompt
